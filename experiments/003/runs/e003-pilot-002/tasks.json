      "task_id": "source-delimited-fields",
      "pair_id": "delimited-fields",
      "instruction": "Fix delimited.py so the documented parse_csv_line behavior is correct. Do not change the public function signature.",
      "visible_files": {
        "delimited.py": [
          "def parse_csv_line(line):",
          "    \"\"\"Parse one CSV line, including quoted commas and doubled quotes.\"\"\"",
          "    return line.split(',')"
        ]
      },
      "external_checks": {
        "external_checks.py": [
          "import unittest",
          "from delimited import parse_csv_line",
          "",
          "class CsvChecks(unittest.TestCase):",
          "    def test_plain(self):",
          "        self.assertEqual(parse_csv_line('a,b,c'), ['a', 'b', 'c'])",
          "",
          "    def test_quoted_comma(self):",
          "        self.assertEqual(parse_csv_line('a,\"b,c\",d'), ['a', 'b,c', 'd'])",
          "",
          "    def test_doubled_quote(self):",
          "        self.assertEqual(parse_csv_line('a,\"b\"\"c\",d'), ['a', 'b\"c', 'd'])",
          "",
          "    def test_empty_fields(self):",
          "        self.assertEqual(parse_csv_line(',a,'), ['', 'a', ''])",
          "",
          "    def test_unterminated_quote(self):",
          "        with self.assertRaises(ValueError):",
          "            parse_csv_line('a,\"b,c')",
          "",
          "if __name__ == '__main__':",
          "    unittest.main()"
        ]
      }
    },
    {
      "task_id": "source-dependency-order",
      "pair_id": "dependency-order",
      "instruction": "Fix dependency.py so the documented topological_order behavior is correct. Do not change the public function signature.",
      "visible_files": {
        "dependency.py": [
          "def topological_order(dependencies):",
          "    \"\"\"Return a stable order with every prerequisite before its node; raise ValueError on cycles.\"\"\"",
          "    return sorted(dependencies)"
        ]
      },
      "external_checks": {
        "external_checks.py": [
          "import unittest",
          "from dependency import topological_order",
          "",
          "class DependencyChecks(unittest.TestCase):",
          "    def test_chain(self):",
          "        self.assertEqual(topological_order({'build': ['test'], 'test': ['code'], 'code': []}), ['code', 'test', 'build'])",
          "",
          "    def test_prerequisite_only_node(self):",
          "        result = topological_order({'ship': ['build']})",
          "        self.assertEqual(result, ['build', 'ship'])",
          "",
          "    def test_stable_tie_break(self):",
          "        self.assertEqual(topological_order({'b': [], 'a': [], 'c': ['a', 'b']}), ['a', 'b', 'c'])",
          "",
          "    def test_cycle(self):",
          "        with self.assertRaises(ValueError):",
          "            topological_order({'a': ['b'], 'b': ['a']})",
          "",
          "if __name__ == '__main__':",
          "    unittest.main()"
        ]
      }
    }
